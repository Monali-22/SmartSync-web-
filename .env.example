# Gemini API Configuration - Get your key from https://makersuite.google.com/app/apikey
# Leave empty to use mock responses (fallback mode)
NEXT_PUBLIC_GEMINI_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME=SmartSync AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags - Enable demo data feature
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# Note: All environment variables are optional. The app gracefully handles missing Gemini API key
# by returning mock recommendations instead of calling the actual API.
